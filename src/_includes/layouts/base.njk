<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = navTitle or title %}
  {% if pageTitle %}{% set fullTitle = pageTitle + " | " + site.name %}<title>{{ fullTitle if fullTitle.length <= 64 else pageTitle }}</title>{% else %}<title>{{ site.name }} – {{ site.tagline }}</title>{% endif %}
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <meta name="theme-color" content="#101826">
  <meta name="robots" content="{{ robots or 'index, follow' }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="cs_CZ">
  <meta property="og:title" content="{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
  <meta property="og:image" content="{{ site.domain }}{{ images['og-image'] }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Rychlé čištění Praha – profesionální čištění vozidel a úklidové služby">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.domain }}{{ images['og-image'] }}">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/icon-180.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} – blog" href="/feed.xml">
  {% if preload %}<link rel="preload" as="image" href="{{ preload | imgSrc }}" fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="{% asset '/assets/css/style.css' %}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": {{ (site.domain + "/#organization") | dump | safe }},
    "name": {{ site.name | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "url": {{ site.domain | dump | safe }},
    "telephone": {{ site.phone | dump | safe }},
    "email": {{ site.email | dump | safe }},
    "logo": {{ (site.domain + images.logo) | dump | safe }},
    "image": {{ [ (site.domain + images.hero), (site.domain + images["tym-radek-ingr"]), (site.domain + images["card-cisteni-vozidel"]) ] | dump | safe }},
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.address.street | dump | safe }},
      "addressLocality": "Praha 3",
      "postalCode": "130 00",
      "addressCountry": "CZ"
    },
    "areaServed": [
      { "@type": "City", "name": "Praha" },
      { "@type": "AdministrativeArea", "name": "Středočeský kraj" }
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "07:00",
      "closes": "21:00"
    },
    "sameAs": [{{ site.social.facebook | dump | safe }}, {{ site.social.instagram | dump | safe }}]
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">Přeskočit na obsah</a>

  {% include "partials/header.njk" %}

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/lightbox.njk" %}

  {% include "partials/whatsapp-floating.njk" %}

  <script src="{% asset '/assets/js/main.js' %}" defer></script>
</body>
</html>
