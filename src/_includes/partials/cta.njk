<section class="cta">
  <div class="container cta__inner">
    <div class="cta__content">
      <h2 class="cta__title">{{ home.cta.title }}</h2>
      <p class="cta__text">{{ home.cta.text }}</p>
      <div class="cta__actions">
        <a class="btn btn--primary" href="tel:{{ site.phoneHref }}">{% icon "phone" %}<span>{{ site.phone }}</span></a>
        <a class="btn btn--ghost" href="mailto:{{ site.email }}">{% icon "mail" %}<span>Napsat e-mail</span></a>
        <a class="btn btn--ghost" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">{% icon "whatsapp" %}<span>WhatsApp</span></a>
      </div>
      <ul class="cta__meta">
        <li>{% icon "clock" %}{{ site.hours }}</li>
        <li>{% icon "pin" %}{{ site.area }}</li>
      </ul>
    </div>
    <div class="cta__media">
      {% picture home.cta.image, "Kontaktujte " + site.name, "", "320px", "lazy" %}
    </div>
  </div>
</section>
