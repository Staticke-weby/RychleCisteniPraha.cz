---
permalink: "/feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }}</title>
    <link>{{ site.domain }}/</link>
    <description>{{ site.description | escape }}</description>
    <language>cs</language>
    <atom:link href="{{ site.domain }}/feed.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ collections.clanky[0].data.date | rssDate }}</lastBuildDate>
    {%- for a in collections.clanky %}
    <item>
      <title>{{ a.data.title | escape }}</title>
      <link>{{ site.domain }}{{ a.url }}</link>
      <guid isPermaLink="true">{{ site.domain }}{{ a.url }}</guid>
      <pubDate>{{ a.data.date | rssDate }}</pubDate>
      <description>{{ a.data.excerpt | escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
