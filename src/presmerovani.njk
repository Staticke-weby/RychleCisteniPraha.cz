---
pagination:
  data: legacyRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <title>Stránka byla přesunuta | {{ site.name }}</title>
  <link rel="canonical" href="{{ site.domain }}{{ redirect.to }}">
  <meta name="robots" content="noindex, follow">
  <meta http-equiv="refresh" content="0; url={{ redirect.to | url }}">
  <script>location.replace({{ (redirect.to | url) | dump | safe }});</script>
</head>
<body>
  <p>Stránka byla přesunuta na novou adresu. Pokud nedojde k přesměrování automaticky, pokračujte na
    <a href="{{ redirect.to | url }}">{{ site.domain }}{{ redirect.to }}</a>.</p>
</body>
</html>
